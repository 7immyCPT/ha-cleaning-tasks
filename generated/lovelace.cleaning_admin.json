{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.cleaning_admin",
  "data": {
    "config": {
      "title": "Cleaning - Admin",
      "views": [
        {
          "title": "Reports",
          "path": "reports",
          "icon": "mdi:file-chart",
          "cards": [
            {
              "type": "markdown",
              "content": "## Today ({{ states('pyscript.cleaning_today') }})\nIf the checklist got messed up (wrong day, mis-tap), this undoes every tick made today and starts it over.\n"
            },
            {
              "type": "button",
              "name": "Reset today's checklist",
              "icon": "mdi:restart",
              "tap_action": {
                "action": "call-service",
                "service": "pyscript.cleaning_reset_today",
                "confirmation": {
                  "text": "Undo every task ticked off today?"
                }
              }
            },
            {
              "type": "markdown",
              "content": "## Completion Log\nEvery tick below is timestamped automatically by Home Assistant's built-in Logbook - no custom report needed.\n"
            },
            {
              "type": "logbook",
              "title": "Recent completions",
              "entities": [
                "input_boolean.done_kitchen_counters",
                "input_boolean.done_kitchen_floor",
                "input_boolean.done_kitchen_sink",
                "input_boolean.done_kitchen_fridge",
                "input_boolean.done_kitchen_microwave",
                "input_boolean.done_kitchen_windows",
                "input_boolean.done_kitchen_oven",
                "input_boolean.done_kitchen_cupboard_fronts",
                "input_boolean.done_pantry_shelves_wipe",
                "input_boolean.done_pantry_floor",
                "input_boolean.done_pantry_tidy_expiry",
                "input_boolean.done_mbath_toilet",
                "input_boolean.done_mbath_shower",
                "input_boolean.done_mbath_basin",
                "input_boolean.done_mbath_floor",
                "input_boolean.done_mbath_mirror",
                "input_boolean.done_mbath_windows",
                "input_boolean.done_mbath_tiles",
                "input_boolean.done_gbath_toilet",
                "input_boolean.done_gbath_shower",
                "input_boolean.done_gbath_basin",
                "input_boolean.done_gbath_floor",
                "input_boolean.done_gbath_mirror",
                "input_boolean.done_gbath_windows",
                "input_boolean.done_gbath_tiles",
                "input_boolean.done_living_dust",
                "input_boolean.done_living_vacuum",
                "input_boolean.done_living_floor",
                "input_boolean.done_living_windows",
                "input_boolean.done_living_curtains",
                "input_boolean.done_living_skirting",
                "input_boolean.done_braai_sweep",
                "input_boolean.done_braai_surfaces",
                "input_boolean.done_braai_grill_area",
                "input_boolean.done_braai_windows",
                "input_boolean.done_braai_cobwebs",
                "input_boolean.done_office_dust",
                "input_boolean.done_office_vacuum",
                "input_boolean.done_office_bin",
                "input_boolean.done_office_windows",
                "input_boolean.done_mbed_dust",
                "input_boolean.done_mbed_vacuum",
                "input_boolean.done_mbed_linen",
                "input_boolean.done_mbed_windows",
                "input_boolean.done_mbed_wardrobe",
                "input_boolean.done_sbed_dust",
                "input_boolean.done_sbed_vacuum",
                "input_boolean.done_sbed_linen",
                "input_boolean.done_sbed_windows",
                "input_boolean.done_sbed_wardrobe",
                "input_boolean.done_dbed_dust",
                "input_boolean.done_dbed_vacuum",
                "input_boolean.done_dbed_linen",
                "input_boolean.done_dbed_windows",
                "input_boolean.done_dbed_wardrobe"
              ]
            },
            {
              "type": "markdown",
              "content": "## Outstanding this month ({{ states('pyscript.cleaning_outstanding') }} items)\n{% for item in state_attr('pyscript.cleaning_outstanding','items') or [] %} - **{{ item.room }}**: {{ item.task }} {% endfor %}\n"
            },
            {
              "type": "button",
              "name": "Refresh outstanding list",
              "icon": "mdi:refresh",
              "tap_action": {
                "action": "call-service",
                "service": "pyscript.cleaning_force_catchup"
              }
            }
          ]
        },
        {
          "title": "Settings",
          "path": "settings",
          "icon": "mdi:cog",
          "cards": [
            {
              "type": "entities",
              "title": "Which days does the cleaner come?",
              "entities": [
                "input_boolean.cleaning_day_mon",
                "input_boolean.cleaning_day_tue",
                "input_boolean.cleaning_day_wed",
                "input_boolean.cleaning_day_thu",
                "input_boolean.cleaning_day_fri",
                "input_boolean.cleaning_day_sat",
                "input_boolean.cleaning_day_sun"
              ]
            },
            {
              "type": "custom:voice-picker-card"
            }
          ]
        }
      ]
    }
  }
